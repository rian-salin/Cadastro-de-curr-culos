# Copie para .env e ajuste o que precisar. Todos os valores já têm um padrão de
# desenvolvimento no docker-compose.yml: o .env só é necessário para mudar algum.
# Nenhuma credencial real deve entrar neste arquivo nem no .env (que é ignorado
# pelo Git).

# Senha do usuário `sa` do SQL Server do compose. O SQL Server exige ao menos 8
# caracteres e 3 destas 4 categorias: maiúsculas, minúsculas, dígitos, símbolos.
# Só é aplicada na primeira subida; para trocar depois, recrie o volume com
# `docker compose down -v` (apaga os dados).
DB_PASSWORD=ChangeMe_2026!

# Nome da base criada pelas migrations.
DB_NAME=CadastroCurriculosDb

# Development expõe o OpenAPI em /openapi/v1.json. Use Production para desligar.
ASPNETCORE_ENVIRONMENT=Development

# Apenas para usar um SQL Server que já existe, com
# `-f docker-compose.yml -f docker-compose.external-db.yml` (veja o README).
# Nunca comite a senha real: preencha no .env.
# DB_CONNECTION_STRING=Server=host.docker.internal,1433;Database=CadastroCurriculosDb;User Id=sa;Password=SUA_SENHA;TrustServerCertificate=True;Connect Timeout=5;
